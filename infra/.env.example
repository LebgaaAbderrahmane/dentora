# PostgreSQL
POSTGRES_DB=dentora
POSTGRES_USER=dentora
POSTGRES_PASSWORD=change-me-strong
DATABASE_URL=postgresql://dentora:change-me-strong@postgres:5432/dentora?schema=public

# MinIO (S3 object storage)
MINIO_ROOT_USER=dentora
MINIO_ROOT_PASSWORD=change-me-strong

# API
API_PORT=4000
# Session lifetime in days (default 30)
SESSION_TTL_DAYS=30
# Log level for structured logs (trace|debug|info|warn|error)
LOG_LEVEL=info
# Generate: openssl rand -hex 32  (AES-256-GCM key for field-level encryption, ADR 006)
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# Sentry error tracking (ADR 009) — leave empty to disable
# DSN looks like: https://<key>@<org>.ingest.sentry.io/<project>
SENTRY_DSN=

# Browser SPAs read these at build time (vite). Leave empty to disable.
VITE_SENTRY_DSN=

# Seed admin (created by prisma db seed)
ADMIN_EMAIL=admin@dentora.dz
ADMIN_PASSWORD=change-me-strong
ADMIN_NAME=Dr. Admin
BRANCH_NAME=Dentora Algiers

# Public domains (used by Caddy)
CADDY_EMAIL=admin@dentora.dz
WEB_DOMAIN=dentora.dz
WWW_WEB_DOMAIN=www.dentora.dz
ADMIN_DOMAIN=admin.dentora.dz
PORTAL_DOMAIN=portal.dentora.dz
API_DOMAIN=api.dentora.dz
