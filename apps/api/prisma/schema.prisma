generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DENTIST
  RECEPTIONIST
  ACCOUNTANT
  INTERN
  PATIENT
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  CHANGE_PASSWORD
  REVOKE_ALL_SESSIONS
  USER_ROLE_CHANGE
  REVOKE_SESSIONS
  PATIENT_VIEW
  PATIENT_CREATE
  PATIENT_UPDATE
  PATIENT_ARCHIVED
  PATIENT_RESTORE
  PATIENT_MEDICAL_VIEW
  PATIENT_MEDICAL_UPDATE
  PATIENT_ODONTOGRAM_VIEW
  PATIENT_ODONTOGRAM_UPDATE
  PATIENT_DOCUMENT_CREATE
  PATIENT_DOCUMENT_VIEW
  APPOINTMENT_CREATE
  APPOINTMENT_UPDATE
  APPOINTMENT_CANCEL
  APPOINTMENT_RESCHEDULE
  APPOINTMENT_VIEW
  APPOINTMENT_NOSHOW
  WAITLIST_CREATE
  WAITLIST_UPDATE
  WAITLIST_BOOK
  WAITLIST_CANCEL
  SERVICE_CREATE
  SERVICE_UPDATE
  SERVICE_ARCHIVE
  SERVICE_RESTORE
  INVOICE_CREATE
  INVOICE_VOID
  PAYMENT_CREATE
  PAYMENT_REFUND
}

enum AuditTarget {
  USER
  SESSION
  PATIENT
  BRANCH
  SYSTEM
  SERVICE
  INVOICE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NOSHOW
}

enum WaitlistStatus {
  PENDING
  CONTACTED
  BOOKED
  CANCELLED
  EXPIRED
}

enum ServiceCategory {
  CONSULTATION
  SURGERY
  CARE
  HYGIENE
  PROSTHETIC_ORTHO
  IMAGING
}

enum PaymentKind {
  RECEIPT
  REFUND
}

enum PaymentMethod {
  CASH
  CHEQUE
  CARD
  TRANSFER
}

model Branch {
  id           String            @id @default(cuid())
  name         String
  address      String?
  phone        String?
  email        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  users        User[]
  patients     Patient[]
  settings     Setting[]
  documents    PatientDocument[]
  appointments Appointment[]
  waitlist     WaitlistEntry[]
  services     Service[]
  invoices     Invoice[]
  payments     Payment[]

  @@map("branches")
}

model User {
  id                   String            @id @default(cuid())
  branchId             String
  branch               Branch            @relation(fields: [branchId], references: [id])
  email                String            @unique
  passwordHash         String
  name                 String
  role                 Role              @default(RECEPTIONIST)
  active               Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  sessions             Session[]
  documents            PatientDocument[]
  assignedAppointments Appointment[]     @relation("AssignedDentist")
  createdAppointments  Appointment[]     @relation("AppointmentCreator")
  waitlistDentist      WaitlistEntry[]   @relation("WaitlistDentist")
  createdWaitlist      WaitlistEntry[]   @relation("WaitlistCreator")
  createdInvoices      Invoice[]         @relation("InvoiceCreator")
  createdPayments      Payment[]         @relation("PaymentCreator")

  @@index([branchId])
  @@map("users")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@map("sessions")
}

model Patient {
  id             String                 @id @default(cuid())
  branchId       String
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  gender         String?
  birthDate      DateTime?
  phone          String?
  email          String?
  address        String?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  medicalHistory PatientMedicalHistory?
  odontogram     PatientOdontogram?
  documents      PatientDocument[]
  appointments   Appointment[]
  waitlist       WaitlistEntry[]
  invoices       Invoice[]

  @@index([branchId])
  @@index([firstName, lastName])
  @@map("patients")
}

model PatientDocument {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id])
  objectKey    String   @unique
  originalName String
  mimeType     String
  size         Int // original plaintext byte length (NOT the encrypted blob size)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([patientId])
  @@index([branchId])
  @@map("patient_documents")
}

model PatientMedicalHistory {
  id        String   @id @default(cuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  data      String
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patient_medical_histories")
}

model PatientOdontogram {
  id        String   @id @default(cuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  data      String
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patient_odontograms")
}

model Appointment {
  id            String            @id @default(cuid())
  branchId      String
  branch        Branch            @relation(fields: [branchId], references: [id])
  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentistId     String?
  dentist       User?             @relation("AssignedDentist", fields: [dentistId], references: [id])
  startAt       DateTime
  endAt         DateTime
  status        AppointmentStatus @default(PENDING)
  notes         String? // encrypted at rest
  createdById   String?
  createdBy     User?             @relation("AppointmentCreator", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  waitlistEntry WaitlistEntry?    @relation("WaitlistAppointment")

  @@index([branchId, startAt])
  @@index([branchId, status, startAt])
  @@index([branchId, dentistId, startAt])
  @@index([patientId, startAt])
  @@map("appointments")
}

model WaitlistEntry {
  id            String         @id @default(cuid())
  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id])
  patientId     String
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentistId     String?
  dentist       User?          @relation("WaitlistDentist", fields: [dentistId], references: [id])
  preferredDate DateTime?
  notes         String?
  status        WaitlistStatus @default(PENDING)
  appointmentId String?        @unique
  appointment   Appointment?   @relation("WaitlistAppointment", fields: [appointmentId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?          @relation("WaitlistCreator", fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([branchId, status, createdAt])
  @@index([branchId, dentistId, status])
  @@index([patientId])
  @@map("waitlist_entries")
}

model Service {
  id              String          @id @default(cuid())
  branchId        String
  branch          Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name            String
  category        ServiceCategory
  priceDZD        Int // whole dinars only, no sub-unit precision (ADR 017)
  durationMinutes Int // estimated minutes; reserved for scheduling/availability later
  reimbursablePct Int             @default(0) // 0–100, convention coverage (CNAS/CASNOS style)
  archivedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([branchId, category])
  @@index([branchId, archivedAt])
  @@map("services")
}

// Invoice lines SNAPSHOT name + price at issue time (ADR 017: catalog changes must
// never rewrite billing history). `serviceId` is kept only for traceability; the
// line never re-reads the catalog. Lines are immutable — an issued invoice is
// corrected by voiding + re-issuing, never edited.
model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId   String?
  serviceName String
  priceDZD    Int // whole dinars, no sub-unit precision (ADR 017)
  quantity    Int
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Invoice {
  id            String        @id @default(cuid())
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  invoiceNumber Int // sequential per branch, allocated atomically (ADR 018)
  issuedAt      DateTime      @default(now())
  voidedAt      DateTime?
  createdById   String?
  createdBy     User?         @relation("InvoiceCreator", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lines         InvoiceLine[]
  payments      Payment[]

  @@unique([branchId, invoiceNumber])
  @@index([branchId, issuedAt])
  @@index([branchId, patientId])
  @@map("invoices")
}

// Receipts (money in) and refunds (money out) share one table, discriminated by `kind`.
// Refunds are immutable money-out rows that reverse a receipt via the `refundsId`
// self-reference; `paidDZD` is always derived = Σ(RECEIPT) − Σ(REFUND) (ADR 019). The
// over-payment and over-refund guards are enforced at write time, never by editing.
model Payment {
  id         String        @id @default(cuid())
  branchId   String
  branch     Branch        @relation(fields: [branchId], references: [id])
  invoiceId  String
  invoice    Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  kind       PaymentKind   @default(RECEIPT)
  method     PaymentMethod
  amountDZD  Int // whole positive dinars, no sub-unit precision (ADR 017)
  reference  String?
  notes      String?
  receivedAt DateTime      @default(now())
  refundsId  String?
  refunds    Payment?      @relation("RefundsPayment", fields: [refundsId], references: [id])
  refundedBy Payment[]     @relation("RefundsPayment")
  createdById String?
  createdBy  User?         @relation("PaymentCreator", fields: [createdById], references: [id])
  createdAt  DateTime      @default(now())

  @@index([invoiceId, receivedAt])
  @@index([branchId, receivedAt])
  @@index([branchId, kind])
  @@map("payments")
}

model Setting {
  id       String  @id @default(cuid())
  branchId String
  branch   Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  key      String
  value    String?

  @@unique([branchId, key])
  @@map("settings")
}

model AuditLog {
  id         String      @id @default(cuid())
  branchId   String
  actorId    String?
  actorEmail String?
  action     AuditAction
  targetType AuditTarget
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([branchId, createdAt])
  @@index([branchId, action, createdAt])
  @@index([action])
  @@index([actorId])
  @@map("audit_logs")
}
