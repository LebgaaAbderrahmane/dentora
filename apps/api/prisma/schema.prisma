generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DENTIST
  RECEPTIONIST
  ACCOUNTANT
  INTERN
  PATIENT
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  CHANGE_PASSWORD
  REVOKE_ALL_SESSIONS
  USER_ROLE_CHANGE
  REVOKE_SESSIONS
  PATIENT_VIEW
  PATIENT_CREATE
  PATIENT_UPDATE
  PATIENT_ARCHIVED
  PATIENT_RESTORE
  PATIENT_MEDICAL_VIEW
  PATIENT_MEDICAL_UPDATE
  PATIENT_ODONTOGRAM_VIEW
  PATIENT_ODONTOGRAM_UPDATE
  PATIENT_DOCUMENT_CREATE
  PATIENT_DOCUMENT_VIEW
  APPOINTMENT_CREATE
  APPOINTMENT_UPDATE
  APPOINTMENT_CANCEL
  APPOINTMENT_RESCHEDULE
  APPOINTMENT_VIEW
  APPOINTMENT_NOSHOW
}

enum AuditTarget {
  USER
  SESSION
  PATIENT
  BRANCH
  SYSTEM
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NOSHOW
}

model Branch {
  id           String            @id @default(cuid())
  name         String
  address      String?
  phone        String?
  email        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  users        User[]
  patients     Patient[]
  settings     Setting[]
  documents    PatientDocument[]
  appointments Appointment[]

  @@map("branches")
}

model User {
  id                   String            @id @default(cuid())
  branchId             String
  branch               Branch            @relation(fields: [branchId], references: [id])
  email                String            @unique
  passwordHash         String
  name                 String
  role                 Role              @default(RECEPTIONIST)
  active               Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  sessions             Session[]
  documents            PatientDocument[]
  assignedAppointments Appointment[]     @relation("AssignedDentist")
  createdAppointments  Appointment[]     @relation("AppointmentCreator")

  @@index([branchId])
  @@map("users")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@map("sessions")
}

model Patient {
  id             String                 @id @default(cuid())
  branchId       String
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  gender         String?
  birthDate      DateTime?
  phone          String?
  email          String?
  address        String?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  medicalHistory PatientMedicalHistory?
  odontogram     PatientOdontogram?
  documents      PatientDocument[]
  appointments   Appointment[]

  @@index([branchId])
  @@index([firstName, lastName])
  @@map("patients")
}

model PatientDocument {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id])
  objectKey    String   @unique
  originalName String
  mimeType     String
  size         Int // original plaintext byte length (NOT the encrypted blob size)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([patientId])
  @@index([branchId])
  @@map("patient_documents")
}

model PatientMedicalHistory {
  id        String   @id @default(cuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  data      String
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patient_medical_histories")
}

model PatientOdontogram {
  id        String   @id @default(cuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  data      String
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patient_odontograms")
}

model Appointment {
  id          String            @id @default(cuid())
  branchId    String
  branch      Branch            @relation(fields: [branchId], references: [id])
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentistId   String?
  dentist     User?             @relation("AssignedDentist", fields: [dentistId], references: [id])
  startAt     DateTime
  endAt       DateTime
  status      AppointmentStatus @default(PENDING)
  notes       String? // encrypted at rest
  createdById String?
  createdBy   User?             @relation("AppointmentCreator", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([branchId, startAt])
  @@index([branchId, status, startAt])
  @@index([branchId, dentistId, startAt])
  @@index([patientId, startAt])
  @@map("appointments")
}

model Setting {
  id       String  @id @default(cuid())
  branchId String
  branch   Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  key      String
  value    String?

  @@unique([branchId, key])
  @@map("settings")
}

model AuditLog {
  id         String      @id @default(cuid())
  branchId   String
  actorId    String?
  actorEmail String?
  action     AuditAction
  targetType AuditTarget
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([branchId, createdAt])
  @@index([branchId, action, createdAt])
  @@index([action])
  @@index([actorId])
  @@map("audit_logs")
}
