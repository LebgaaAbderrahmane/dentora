generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DENTIST
  RECEPTIONIST
  ACCOUNTANT
  INTERN
  PATIENT
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  CHANGE_PASSWORD
  REVOKE_ALL_SESSIONS
  USER_ROLE_CHANGE
  REVOKE_SESSIONS
  PATIENT_VIEW
  PATIENT_CREATE
  PATIENT_UPDATE
  PATIENT_ARCHIVED
  PATIENT_RESTORE
  PATIENT_MEDICAL_VIEW
  PATIENT_MEDICAL_UPDATE
  PATIENT_ODONTOGRAM_VIEW
  PATIENT_ODONTOGRAM_UPDATE
  PATIENT_DOCUMENT_CREATE
  PATIENT_DOCUMENT_VIEW
  APPOINTMENT_CREATE
  APPOINTMENT_UPDATE
  APPOINTMENT_CANCEL
  APPOINTMENT_RESCHEDULE
  APPOINTMENT_VIEW
  APPOINTMENT_NOSHOW
  WAITLIST_CREATE
  WAITLIST_UPDATE
  WAITLIST_BOOK
  WAITLIST_CANCEL
  SERVICE_CREATE
  SERVICE_UPDATE
  SERVICE_ARCHIVE
  SERVICE_RESTORE
  INVOICE_CREATE
  INVOICE_VOID
  PAYMENT_CREATE
  PAYMENT_REFUND
  EXPENSE_CREATE
  EXPENSE_UPDATE
  EXPENSE_VOID
  PRODUCT_CREATE
  PRODUCT_UPDATE
  PRODUCT_ARCHIVE
  PRODUCT_RESTORE
  SUPPLIER_CREATE
  SUPPLIER_UPDATE
  SUPPLIER_ARCHIVE
  SUPPLIER_RESTORE
  PURCHASE_ORDER_CREATE
  PURCHASE_ORDER_UPDATE
  PURCHASE_ORDER_RECEIVE
  PURCHASE_ORDER_CANCEL
  STOCK_OUT
  STOCK_ADJUST
}

enum AuditTarget {
  USER
  SESSION
  PATIENT
  BRANCH
  SYSTEM
  SERVICE
  INVOICE
  EXPENSE
  PRODUCT
  SUPPLIER
  PURCHASE_ORDER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NOSHOW
}

enum WaitlistStatus {
  PENDING
  CONTACTED
  BOOKED
  CANCELLED
  EXPIRED
}

enum ServiceCategory {
  CONSULTATION
  SURGERY
  CARE
  HYGIENE
  PROSTHETIC_ORTHO
  IMAGING
}

enum PaymentKind {
  RECEIPT
  REFUND
}

enum PaymentMethod {
  CASH
  CHEQUE
  CARD
  TRANSFER
}

enum ExpenseCategory {
  SALARY
  RENT
  SUPPLIES
  EQUIPMENT
  UTILITIES
  MAINTENANCE
  MARKETING
  TAXES
  OTHER
}

enum ProductCategory {
  ANESTHETICS
  DISPOSABLES
  MATERIALS
  INSTRUMENTS
  EQUIPMENT
  MEDICATIONS
  LABORATORY
  STATIONERY
  OTHER
}

enum ProductUnit {
  UNIT
  BOX
  PACK
  BOTTLE
  JAR
  SYRINGE
  SET
  KIT
}

// Outreach/procurement state (ADR 023). DRAFT → ORDERED → (receipts) →
// PARTIALLY_RECEIVED → RECEIVED, or CANCELLED while nothing has been received.
enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// Stock movement journal (ADR 024) — append-only. OPENING adds (migration backfill),
// IN adds (purchase receipts), OUT subtracts (usage, with a reason), ADJUST is signed
// (positive = manual in / stock-up, negative = loss / count correction).
enum StockLedgerType {
  OPENING
  IN
  OUT
  ADJUST
}

model Branch {
  id           String            @id @default(cuid())
  name         String
  address      String?
  phone        String?
  email        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  users        User[]
  patients     Patient[]
  settings     Setting[]
  documents    PatientDocument[]
  appointments Appointment[]
  waitlist     WaitlistEntry[]
  services     Service[]
  invoices     Invoice[]
  payments     Payment[]
  expenses     Expense[]
  products     Product[]
  suppliers    Supplier[]
  purchaseOrders PurchaseOrder[]
  stockLedger  StockLedgerEntry[]

  @@map("branches")
}

model User {
  id                   String            @id @default(cuid())
  branchId             String
  branch               Branch            @relation(fields: [branchId], references: [id])
  email                String            @unique
  passwordHash         String
  name                 String
  role                 Role              @default(RECEPTIONIST)
  active               Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  sessions             Session[]
  documents            PatientDocument[]
  assignedAppointments Appointment[]     @relation("AssignedDentist")
  createdAppointments  Appointment[]     @relation("AppointmentCreator")
  waitlistDentist      WaitlistEntry[]   @relation("WaitlistDentist")
  createdWaitlist      WaitlistEntry[]   @relation("WaitlistCreator")
  createdInvoices      Invoice[]         @relation("InvoiceCreator")
  createdPayments      Payment[]         @relation("PaymentCreator")
  createdExpenses      Expense[]         @relation("ExpenseCreator")
  createdProducts      Product[]         @relation("ProductCreator")
  createdSuppliers     Supplier[]        @relation("SupplierCreator")
  createdPurchaseOrders PurchaseOrder[]  @relation("PurchaseOrderCreator")
  createdStock          StockLedgerEntry[] @relation("StockCreator")

  @@index([branchId])
  @@map("users")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@map("sessions")
}

model Patient {
  id             String                 @id @default(cuid())
  branchId       String
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  gender         String?
  birthDate      DateTime?
  phone          String?
  email          String?
  address        String?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  medicalHistory PatientMedicalHistory?
  odontogram     PatientOdontogram?
  documents      PatientDocument[]
  appointments   Appointment[]
  waitlist       WaitlistEntry[]
  invoices       Invoice[]

  @@index([branchId])
  @@index([firstName, lastName])
  @@map("patients")
}

model PatientDocument {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id])
  objectKey    String   @unique
  originalName String
  mimeType     String
  size         Int // original plaintext byte length (NOT the encrypted blob size)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([patientId])
  @@index([branchId])
  @@map("patient_documents")
}

model PatientMedicalHistory {
  id        String   @id @default(cuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  data      String
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patient_medical_histories")
}

model PatientOdontogram {
  id        String   @id @default(cuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  data      String
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patient_odontograms")
}

model Appointment {
  id            String            @id @default(cuid())
  branchId      String
  branch        Branch            @relation(fields: [branchId], references: [id])
  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentistId     String?
  dentist       User?             @relation("AssignedDentist", fields: [dentistId], references: [id])
  startAt       DateTime
  endAt         DateTime
  status        AppointmentStatus @default(PENDING)
  notes         String? // encrypted at rest
  createdById   String?
  createdBy     User?             @relation("AppointmentCreator", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  waitlistEntry WaitlistEntry?    @relation("WaitlistAppointment")

  @@index([branchId, startAt])
  @@index([branchId, status, startAt])
  @@index([branchId, dentistId, startAt])
  @@index([patientId, startAt])
  @@map("appointments")
}

model WaitlistEntry {
  id            String         @id @default(cuid())
  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id])
  patientId     String
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentistId     String?
  dentist       User?          @relation("WaitlistDentist", fields: [dentistId], references: [id])
  preferredDate DateTime?
  notes         String?
  status        WaitlistStatus @default(PENDING)
  appointmentId String?        @unique
  appointment   Appointment?   @relation("WaitlistAppointment", fields: [appointmentId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?          @relation("WaitlistCreator", fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([branchId, status, createdAt])
  @@index([branchId, dentistId, status])
  @@index([patientId])
  @@map("waitlist_entries")
}

model Service {
  id              String          @id @default(cuid())
  branchId        String
  branch          Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name            String
  category        ServiceCategory
  priceDZD        Int // whole dinars only, no sub-unit precision (ADR 017)
  durationMinutes Int // estimated minutes; reserved for scheduling/availability later
  reimbursablePct Int             @default(0) // 0–100, convention coverage (CNAS/CASNOS style)
  archivedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([branchId, category])
  @@index([branchId, archivedAt])
  @@map("services")
}

// Invoice lines SNAPSHOT name + price at issue time (ADR 017: catalog changes must
// never rewrite billing history). `serviceId` is kept only for traceability; the
// line never re-reads the catalog. Lines are immutable — an issued invoice is
// corrected by voiding + re-issuing, never edited.
model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId   String?
  serviceName String
  priceDZD    Int // whole dinars, no sub-unit precision (ADR 017)
  quantity    Int
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Invoice {
  id            String        @id @default(cuid())
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  invoiceNumber Int // sequential per branch, allocated atomically (ADR 018)
  issuedAt      DateTime      @default(now())
  voidedAt      DateTime?
  createdById   String?
  createdBy     User?         @relation("InvoiceCreator", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lines         InvoiceLine[]
  payments      Payment[]

  @@unique([branchId, invoiceNumber])
  @@index([branchId, issuedAt])
  @@index([branchId, patientId])
  @@map("invoices")
}

// Receipts (money in) and refunds (money out) share one table, discriminated by `kind`.
// Refunds are immutable money-out rows that reverse a receipt via the `refundsId`
// self-reference; `paidDZD` is always derived = Σ(RECEIPT) − Σ(REFUND) (ADR 019). The
// over-payment and over-refund guards are enforced at write time, never by editing.
model Payment {
  id         String        @id @default(cuid())
  branchId   String
  branch     Branch        @relation(fields: [branchId], references: [id])
  invoiceId  String
  invoice    Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  kind       PaymentKind   @default(RECEIPT)
  method     PaymentMethod
  amountDZD  Int // whole positive dinars, no sub-unit precision (ADR 017)
  reference  String?
  notes      String?
  receivedAt DateTime      @default(now())
  refundsId  String?
  refunds    Payment?      @relation("RefundsPayment", fields: [refundsId], references: [id])
  refundedBy Payment[]     @relation("RefundsPayment")
  createdById String?
  createdBy  User?         @relation("PaymentCreator", fields: [createdById], references: [id])
  createdAt  DateTime      @default(now())

  @@index([invoiceId, receivedAt])
  @@index([branchId, receivedAt])
  @@index([branchId, kind])
  @@map("payments")
}

// Discretionary cost entry: editable (PATCH, audited before/after) and soft-voided via
// `voidedAt`, never hard-deleted (ADR 020). `incurredAt` is the date the expense belongs
// to for close-out / P&L (2.5); whole dinars, no sub-unit precision (ADR 017).
model Expense {
  id          String           @id @default(cuid())
  branchId    String
  branch      Branch           @relation(fields: [branchId], references: [id])
  category    ExpenseCategory
  amountDZD   Int // whole positive dinars
  description String
  incurredAt  DateTime         @default(now())
  voidedAt    DateTime?
  createdById String?
  createdBy   User?            @relation("ExpenseCreator", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([branchId, incurredAt])
  @@index([branchId, category, incurredAt])
  @@index([branchId, voidedAt])
  @@map("expenses")
}

// Stock catalog row (ADR 022). `quantityOnHand` is transitional in 3.1 — 3.3 replaces it
// with a ledger-derived figure (opening this value as an opening-balance ledger row).
model Product {
  id              String          @id @default(cuid())
  branchId        String
  branch          Branch          @relation(fields: [branchId], references: [id])
  name            String
  code            String?
  category        ProductCategory
  unit            ProductUnit
  reorderLevel    Int             @default(0)
  quantityOnHand  Int             @default(0)
  archivedAt      DateTime?
  createdById     String?
  createdBy       User?           @relation("ProductCreator", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  purchaseOrderLines PurchaseOrderLine[]
  stockLedger         StockLedgerEntry[]

  @@unique([branchId, code])
  @@index([branchId, category])
  @@index([branchId, archivedAt])
  @@map("products")
}

// Branch-scoped vendor directory (ADR 023). Suppliers are soft-archived, never deleted;
// POs keep pointing at them, so archive just hides them from the active supplier picker.
model Supplier {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  name        String
  phone       String?
  email       String?
  address     String?
  notes       String?
  archivedAt  DateTime?
  createdById String?
  createdBy   User?    @relation("SupplierCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  purchaseOrders PurchaseOrder[]

  @@unique([branchId, name])
  @@index([branchId, archivedAt])
  @@map("suppliers")
}

// Purchase order (ADR 023) — finance-desk book, like expenses. Lines SNAPSHOT product name +
// unit at order time (ADR 018-style, immutable once received); status is one stored column
// with transitions enforced at write time; totals derived. Receipts increment the product's
// transitional `quantityOnHand` (3.3 opens them as ledger rows).
model PurchaseOrder {
  id          String            @id @default(cuid())
  branchId    String
  branch      Branch            @relation(fields: [branchId], references: [id])
  supplierId  String?
  supplier    Supplier?         @relation(fields: [supplierId], references: [id])
  reference   String?
  notes       String?
  status      PurchaseOrderStatus @default(ORDERED)
  orderedAt   DateTime          @default(now())
  receivedAt  DateTime?
  createdById String?
  createdBy   User?             @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  lines       PurchaseOrderLine[]
  stockLedger StockLedgerEntry[]

  @@index([branchId, status, createdAt])
  @@index([branchId, supplierId])
  @@index([branchId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String         @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName      String // snapshot at order time (ADR 018-style)
  unit             ProductUnit    // snapshot at order time
  unitPriceDZD     Int // whole dinars, no sub-unit precision (ADR 017)
  quantity         Int
  receivedQuantity Int            @default(0)

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

// Stock movement journal (ADR 024). OPENING adds (migration backfill),
// IN adds (purchase receipts + optional batch/expiry), OUT subtracts (usage,
// with a required reason), ADJUST is signed (positive add / negative subtract).
// quantityOnHand on Product is kept in sync inside the same transaction and always
// equals Σ ledger for the product.
model StockLedgerEntry {
  id              String          @id @default(cuid())
  branchId        String
  branch          Branch          @relation(fields: [branchId], references: [id])
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  type            StockLedgerType
  quantity        Int // whole units; positive for OPENING/IN/OUT, signed for ADJUST
  unitCostDZD     Int?
  batch           String?
  expiryDate      DateTime?
  reason          String?
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  createdById     String?
  createdBy       User?           @relation("StockCreator", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())

  @@index([branchId, createdAt])
  @@index([branchId, productId, createdAt])
  @@index([branchId, type, createdAt])
  @@index([purchaseOrderId])
  @@map("stock_ledger_entries")
}

model Setting {
  id       String  @id @default(cuid())
  branchId String
  branch   Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  key      String
  value    String?

  @@unique([branchId, key])
  @@map("settings")
}

model AuditLog {
  id         String      @id @default(cuid())
  branchId   String
  actorId    String?
  actorEmail String?
  action     AuditAction
  targetType AuditTarget
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([branchId, createdAt])
  @@index([branchId, action, createdAt])
  @@index([action])
  @@index([actorId])
  @@map("audit_logs")
}
