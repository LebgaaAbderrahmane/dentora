generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DENTIST
  RECEPTIONIST
  ACCOUNTANT
  INTERN
  PATIENT
}

// Recurring weekly worker availability (ADR 027). Consumed by the staff
// schedule editor; attendance/rostering in 4.2 will read these templates.
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum InternRotation {
  CONSULTATION
  SURGERY
  CARE
  HYGIENE
  PROSTHETIC_ORTHO
  IMAGING
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  CHANGE_PASSWORD
  REVOKE_ALL_SESSIONS
  USER_ROLE_CHANGE
  REVOKE_SESSIONS
  PATIENT_VIEW
  PATIENT_CREATE
  PATIENT_UPDATE
  PATIENT_ARCHIVED
  PATIENT_RESTORE
  PATIENT_MEDICAL_VIEW
  PATIENT_MEDICAL_UPDATE
  PATIENT_ODONTOGRAM_VIEW
  PATIENT_ODONTOGRAM_UPDATE
  PATIENT_DOCUMENT_CREATE
  PATIENT_DOCUMENT_VIEW
  APPOINTMENT_CREATE
  APPOINTMENT_UPDATE
  APPOINTMENT_CANCEL
  APPOINTMENT_RESCHEDULE
  APPOINTMENT_VIEW
  APPOINTMENT_NOSHOW
  WAITLIST_CREATE
  WAITLIST_UPDATE
  WAITLIST_BOOK
  WAITLIST_CANCEL
  SERVICE_CREATE
  SERVICE_UPDATE
  SERVICE_ARCHIVE
  SERVICE_RESTORE
  INVOICE_CREATE
  INVOICE_VOID
  PAYMENT_CREATE
  PAYMENT_REFUND
  EXPENSE_CREATE
  EXPENSE_UPDATE
  EXPENSE_VOID
  PRODUCT_CREATE
  PRODUCT_UPDATE
  PRODUCT_ARCHIVE
  PRODUCT_RESTORE
  SUPPLIER_CREATE
  SUPPLIER_UPDATE
  SUPPLIER_ARCHIVE
  SUPPLIER_RESTORE
  PURCHASE_ORDER_CREATE
  PURCHASE_ORDER_UPDATE
  PURCHASE_ORDER_RECEIVE
  PURCHASE_ORDER_CANCEL
  STOCK_OUT
  STOCK_ADJUST
  STERILIZATION_CREATE
  STERILIZATION_UPDATE
  STAFF_CREATE
  STAFF_UPDATE
  STAFF_PASSWORD_RESET
  SCHEDULE_UPDATE
  PORTAL_ACCESS_CREATE
  PORTAL_ACCESS_RESET
  ATTENDANCE_CREATE
  ATTENDANCE_UPDATE
  INTERN_CREATE
  INTERN_UPDATE
  PAYROLL_CREATE
  PAYROLL_UPDATE
  PAYROLL_VOID
  NOTIFICATION_CONFIG_UPDATE
  AUDIT_RETENTION_UPDATE
}

enum AuditTarget {
  USER
  SESSION
  PATIENT
  BRANCH
  SYSTEM
  SERVICE
  INVOICE
  EXPENSE
  PRODUCT
  SUPPLIER
  PURCHASE_ORDER
  STERILIZATION
  SCHEDULE
  ATTENDANCE
  INTERN
  PAYROLL
  NOTIFICATION
  AUDIT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NOSHOW
}

enum WaitlistStatus {
  PENDING
  CONTACTED
  BOOKED
  CANCELLED
  EXPIRED
}

enum ServiceCategory {
  CONSULTATION
  SURGERY
  CARE
  HYGIENE
  PROSTHETIC_ORTHO
  IMAGING
}

enum PaymentKind {
  RECEIPT
  REFUND
}

enum PaymentMethod {
  CASH
  CHEQUE
  CARD
  TRANSFER
}

enum ExpenseCategory {
  SALARY
  RENT
  SUPPLIES
  EQUIPMENT
  UTILITIES
  MAINTENANCE
  MARKETING
  TAXES
  OTHER
}

enum ProductCategory {
  ANESTHETICS
  DISPOSABLES
  MATERIALS
  INSTRUMENTS
  EQUIPMENT
  MEDICATIONS
  LABORATORY
  STATIONERY
  OTHER
}

enum ProductUnit {
  UNIT
  BOX
  PACK
  BOTTLE
  JAR
  SYRINGE
  SET
  KIT
}

// Outreach/procurement state (ADR 023). DRAFT → ORDERED → (receipts) →
// PARTIALLY_RECEIVED → RECEIVED, or CANCELLED while nothing has been received.
enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// Stock movement journal (ADR 024) — append-only. OPENING adds (migration backfill),
// IN adds (purchase receipts), OUT subtracts (usage, with a reason), ADJUST is signed
// (positive = manual in / stock-up, negative = loss / count correction).
enum StockLedgerType {
  OPENING
  IN
  OUT
  ADJUST
}

// Instrument decontamination cycle (ADR 026). `operator` is the staff member who runs
// the cycle; IN_PROGRESS becomes COMPLETED/FAILED/CANCELLED, COMPLETED/FAILED set
// `completedAt` at transition time.
enum SterilizationMethod {
  AUTOCLAVE
  CHEMICAL
  UV
  OTHER
}

enum SterilizationStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

model Branch {
  id           String            @id @default(cuid())
  name         String
  address      String?
  phone        String?
  email        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  users        User[]
  patients     Patient[]
  settings     Setting[]
  documents    PatientDocument[]
  appointments Appointment[]
  waitlist     WaitlistEntry[]
  services     Service[]
  invoices     Invoice[]
  payments     Payment[]
  expenses     Expense[]
  products     Product[]
  suppliers    Supplier[]
  purchaseOrders PurchaseOrder[]
  stockLedger  StockLedgerEntry[]
  consumptions TreatmentStockConsumption[]
  sterilizations SterilizationLog[]
  schedules   StaffSchedule[]
  attendance  AttendanceLog[]
  internProfiles InternProfile[]
  payslips   Payslip[]
  notifications NotificationLog[]

  @@map("branches")
}

model User {
  id                   String            @id @default(cuid())
  branchId             String
  branch               Branch            @relation(fields: [branchId], references: [id])
  email                String            @unique
  passwordHash         String
  name                 String
  role                 Role              @default(RECEPTIONIST)
  active               Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  sessions             Session[]
  documents            PatientDocument[]
  assignedAppointments Appointment[]     @relation("AssignedDentist")
  createdAppointments  Appointment[]     @relation("AppointmentCreator")
  waitlistDentist      WaitlistEntry[]   @relation("WaitlistDentist")
  createdWaitlist      WaitlistEntry[]   @relation("WaitlistCreator")
  createdInvoices      Invoice[]         @relation("InvoiceCreator")
  createdPayments      Payment[]         @relation("PaymentCreator")
  createdExpenses      Expense[]         @relation("ExpenseCreator")
  createdProducts      Product[]         @relation("ProductCreator")
  createdSuppliers     Supplier[]        @relation("SupplierCreator")
  createdPurchaseOrders PurchaseOrder[]  @relation("PurchaseOrderCreator")
  createdStock          StockLedgerEntry[] @relation("StockCreator")
  createdConsumptions   TreatmentStockConsumption[] @relation("ConsumptionCreator")
  createdSterilizations SterilizationLog[] @relation("SterilizationCreator")
  operatedSterilizations SterilizationLog[] @relation("SterilizationOperator")
  schedules          StaffSchedule[]       @relation("ScheduleStaff")
  attendance         AttendanceLog[]       @relation("AttendanceStaff")
  createdAttendance  AttendanceLog[]       @relation("AttendanceCreator")
  internProfile      InternProfile?        @relation("InternProfile")
  mentoredInterns    InternProfile[]       @relation("InternMentor")
  payslips           Payslip[]             @relation("PayslipStaff")
  createdPayslips    Payslip[]             @relation("PayslipCreator")
  patientId          String?               @unique
  patient            Patient?              @relation("PatientUser", fields: [patientId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@map("users")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@map("sessions")
}

model Patient {
  id             String                 @id @default(cuid())
  branchId       String
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  gender         String?
  birthDate      DateTime?
  phone          String?
  email          String?
  address        String?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  notifyWhatsapp Boolean                @default(true)
  notifyEmail    Boolean                @default(true)
  medicalHistory PatientMedicalHistory?
  odontogram     PatientOdontogram?
  documents      PatientDocument[]
  appointments   Appointment[]
  waitlist       WaitlistEntry[]
  invoices       Invoice[]
  user           User?              @relation("PatientUser")

  @@index([branchId])
  @@index([firstName, lastName])
  @@index([branchId, phone])
  @@map("patients")
}

model PatientDocument {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id])
  objectKey    String   @unique
  originalName String
  mimeType     String
  size         Int // original plaintext byte length (NOT the encrypted blob size)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([patientId])
  @@index([branchId])
  @@map("patient_documents")
}

model PatientMedicalHistory {
  id        String   @id @default(cuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  data      String
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patient_medical_histories")
}

model PatientOdontogram {
  id        String   @id @default(cuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  data      String
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patient_odontograms")
}

model Appointment {
  id            String            @id @default(cuid())
  branchId      String
  branch        Branch            @relation(fields: [branchId], references: [id])
  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentistId     String?
  dentist       User?             @relation("AssignedDentist", fields: [dentistId], references: [id])
  startAt       DateTime
  endAt         DateTime
  status        AppointmentStatus @default(PENDING)
  notes         String? // encrypted at rest
  createdById   String?
  createdBy     User?             @relation("AppointmentCreator", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  waitlistEntry WaitlistEntry?    @relation("WaitlistAppointment")
  stockLedger   StockLedgerEntry[]
  consumptions  TreatmentStockConsumption[]
  notifications NotificationLog[]

  @@index([branchId, startAt])
  @@index([branchId, status, startAt])
  @@index([branchId, dentistId, startAt])
  @@index([patientId, startAt])
  @@map("appointments")
}

// Outbound appointment-reminder delivery record (ADR 032). One row per
// (appointment, channel) — the unique constraint double-guards the sweep against
// duplicate sends. `status` is the terminal outcome: delivered (SENT), provider
// error (FAILED, with the message), or not attempted (SKIPPED — channel disabled,
// patient opted out, no contact on file). This is the operational audit trail for
// reminders; bodies/credentials live in config, never here.
model NotificationLog {
  id            String             @id @default(cuid())
  branchId      String
  branch        Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  appointmentId String
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  channel       NotificationChannel
  status        NotificationStatus
  to            String // phone E.164 or email, as sent to
  provider      String? // e.g. smtp / generic-webhook
  error         String?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())

  @@unique([appointmentId, channel])
  @@index([branchId, channel, createdAt])
  @@index([branchId, status, createdAt])
  @@map("notification_logs")
}

model WaitlistEntry {
  id            String         @id @default(cuid())
  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id])
  patientId     String
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentistId     String?
  dentist       User?          @relation("WaitlistDentist", fields: [dentistId], references: [id])
  preferredDate DateTime?
  notes         String?
  status        WaitlistStatus @default(PENDING)
  appointmentId String?        @unique
  appointment   Appointment?   @relation("WaitlistAppointment", fields: [appointmentId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?          @relation("WaitlistCreator", fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([branchId, status, createdAt])
  @@index([branchId, dentistId, status])
  @@index([patientId])
  @@map("waitlist_entries")
}

model Service {
  id              String          @id @default(cuid())
  branchId        String
  branch          Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name            String
  category        ServiceCategory
  priceDZD        Int // whole dinars only, no sub-unit precision (ADR 017)
  durationMinutes Int // estimated minutes; reserved for scheduling/availability later
  reimbursablePct Int             @default(0) // 0–100, convention coverage (CNAS/CASNOS style)
  archivedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([branchId, category])
  @@index([branchId, archivedAt])
  @@map("services")
}

// Invoice lines SNAPSHOT name + price at issue time (ADR 017: catalog changes must
// never rewrite billing history). `serviceId` is kept only for traceability; the
// line never re-reads the catalog. Lines are immutable — an issued invoice is
// corrected by voiding + re-issuing, never edited.
model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId   String?
  serviceName String
  priceDZD    Int // whole dinars, no sub-unit precision (ADR 017)
  quantity    Int
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Invoice {
  id            String        @id @default(cuid())
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  invoiceNumber Int // sequential per branch, allocated atomically (ADR 018)
  issuedAt      DateTime      @default(now())
  voidedAt      DateTime?
  createdById   String?
  createdBy     User?         @relation("InvoiceCreator", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lines         InvoiceLine[]
  payments      Payment[]

  @@unique([branchId, invoiceNumber])
  @@index([branchId, issuedAt])
  @@index([branchId, patientId])
  @@map("invoices")
}

// Receipts (money in) and refunds (money out) share one table, discriminated by `kind`.
// Refunds are immutable money-out rows that reverse a receipt via the `refundsId`
// self-reference; `paidDZD` is always derived = Σ(RECEIPT) − Σ(REFUND) (ADR 019). The
// over-payment and over-refund guards are enforced at write time, never by editing.
model Payment {
  id         String        @id @default(cuid())
  branchId   String
  branch     Branch        @relation(fields: [branchId], references: [id])
  invoiceId  String
  invoice    Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  kind       PaymentKind   @default(RECEIPT)
  method     PaymentMethod
  amountDZD  Int // whole positive dinars, no sub-unit precision (ADR 017)
  reference  String?
  notes      String?
  receivedAt DateTime      @default(now())
  refundsId  String?
  refunds    Payment?      @relation("RefundsPayment", fields: [refundsId], references: [id])
  refundedBy Payment[]     @relation("RefundsPayment")
  createdById String?
  createdBy  User?         @relation("PaymentCreator", fields: [createdById], references: [id])
  createdAt  DateTime      @default(now())

  @@index([invoiceId, receivedAt])
  @@index([branchId, receivedAt])
  @@index([branchId, kind])
  @@map("payments")
}

// Discretionary cost entry: editable (PATCH, audited before/after) and soft-voided via
// `voidedAt`, never hard-deleted (ADR 020). `incurredAt` is the date the expense belongs
// to for close-out / P&L (2.5); whole dinars, no sub-unit precision (ADR 017).
model Expense {
  id          String           @id @default(cuid())
  branchId    String
  branch      Branch           @relation(fields: [branchId], references: [id])
  category    ExpenseCategory
  amountDZD   Int // whole positive dinars
  description String
  incurredAt  DateTime         @default(now())
  voidedAt    DateTime?
  createdById String?
  createdBy   User?            @relation("ExpenseCreator", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([branchId, incurredAt])
  @@index([branchId, category, incurredAt])
  @@index([branchId, voidedAt])
  @@map("expenses")
}

// Stock catalog row (ADR 022). `quantityOnHand` is transitional in 3.1 — 3.3 replaces it
// with a ledger-derived figure (opening this value as an opening-balance ledger row).
model Product {
  id              String          @id @default(cuid())
  branchId        String
  branch          Branch          @relation(fields: [branchId], references: [id])
  name            String
  code            String?
  category        ProductCategory
  unit            ProductUnit
  reorderLevel    Int             @default(0)
  quantityOnHand  Int             @default(0)
  archivedAt      DateTime?
  createdById     String?
  createdBy       User?           @relation("ProductCreator", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  purchaseOrderLines PurchaseOrderLine[]
  stockLedger         StockLedgerEntry[]
  consumptions        TreatmentStockConsumption[]
  sterilizations      SterilizationLog[]

  @@unique([branchId, code])
  @@index([branchId, category])
  @@index([branchId, archivedAt])
  @@map("products")
}

// Branch-scoped vendor directory (ADR 023). Suppliers are soft-archived, never deleted;
// POs keep pointing at them, so archive just hides them from the active supplier picker.
model Supplier {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  name        String
  phone       String?
  email       String?
  address     String?
  notes       String?
  archivedAt  DateTime?
  createdById String?
  createdBy   User?    @relation("SupplierCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  purchaseOrders PurchaseOrder[]

  @@unique([branchId, name])
  @@index([branchId, archivedAt])
  @@map("suppliers")
}

// Purchase order (ADR 023) — finance-desk book, like expenses. Lines SNAPSHOT product name +
// unit at order time (ADR 018-style, immutable once received); status is one stored column
// with transitions enforced at write time; totals derived. Receipts increment the product's
// transitional `quantityOnHand` (3.3 opens them as ledger rows).
model PurchaseOrder {
  id          String            @id @default(cuid())
  branchId    String
  branch      Branch            @relation(fields: [branchId], references: [id])
  supplierId  String?
  supplier    Supplier?         @relation(fields: [supplierId], references: [id])
  reference   String?
  notes       String?
  status      PurchaseOrderStatus @default(ORDERED)
  orderedAt   DateTime          @default(now())
  receivedAt  DateTime?
  createdById String?
  createdBy   User?             @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  lines       PurchaseOrderLine[]
  stockLedger StockLedgerEntry[]

  @@index([branchId, status, createdAt])
  @@index([branchId, supplierId])
  @@index([branchId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String         @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName      String // snapshot at order time (ADR 018-style)
  unit             ProductUnit    // snapshot at order time
  unitPriceDZD     Int // whole dinars, no sub-unit precision (ADR 017)
  quantity         Int
  receivedQuantity Int            @default(0)

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

// Stock movement journal (ADR 024). OPENING adds (migration backfill),
// IN adds (purchase receipts + optional batch/expiry), OUT subtracts (usage,
// with a required reason), ADJUST is signed (positive add / negative subtract).
// quantityOnHand on Product is kept in sync inside the same transaction and always
// equals Σ ledger for the product. OUT rows written by treatment consumption carry
// `appointmentId` so the finance journal traces back to the clinical act (ADR 026).
model StockLedgerEntry {
  id              String          @id @default(cuid())
  branchId        String
  branch          Branch          @relation(fields: [branchId], references: [id])
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  type            StockLedgerType
  quantity        Int // whole units; positive for OPENING/IN/OUT, signed for ADJUST
  unitCostDZD     Int?
  batch           String?
  expiryDate      DateTime?
  reason          String?
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  appointmentId   String?
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?           @relation("StockCreator", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())

  @@index([branchId, createdAt])
  @@index([branchId, productId, createdAt])
  @@index([branchId, type, createdAt])
  @@index([purchaseOrderId])
  @@index([appointmentId])
  @@map("stock_ledger_entries")
}

// Clinical stock usage tied to a treatment appointment (ADR 026). Each row is written
// together with an OUT ledger entry + product decrement inside one transaction, so the
// demo-seed breadcrumb `Σ ledger == quantityOnHand` keeps holding. A consumption is a
// clinical record (dentist/receptionist desk), distinct from the manual finance OUT;
// corrections are new movements, never edits (ADR 024).
model TreatmentStockConsumption {
  id            String    @id @default(cuid())
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id])
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Int // whole positive units consumed
  batch         String?
  reason        String?
  consumedAt    DateTime  @default(now())
  createdById   String?
  createdBy     User?     @relation("ConsumptionCreator", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([branchId, consumedAt])
  @@index([branchId, productId, consumedAt])
  @@index([appointmentId])
  @@map("treatment_stock_consumptions")
}

// Instrument sterilization log (ADR 026) — one row per cycle. `instrument` is a snapshot
// name; `productId` optionally links the catalog instrument (INSTRUMENTS/EQUIPMENT) but the
// row must stay readable even if the catalog row is later archived. No hard deletes;
// mistakes are corrected by marking the cycle CANCELLED/FAILED.
model SterilizationLog {
  id          String               @id @default(cuid())
  branchId    String
  branch      Branch               @relation(fields: [branchId], references: [id])
  productId   String?
  product     Product?             @relation(fields: [productId], references: [id], onDelete: Restrict)
  instrument  String
  method      SterilizationMethod
  cycle       Int?
  status      SterilizationStatus  @default(IN_PROGRESS)
  startedAt   DateTime
  completedAt DateTime?
  operatorId  String?
  operator    User?                @relation("SterilizationOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  notes       String?
  createdById String?
  createdBy   User?                @relation("SterilizationCreator", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([branchId, startedAt])
  @@index([branchId, status, startedAt])
  @@index([branchId, productId])
  @@index([operatorId])
  @@map("sterilization_logs")
}

// Recurring weekly worker availability (ADR 027). One row per weekday slot;
// times are local HH:mm strings. A staff member can have several rows on one
// weekday (e.g. two half-days); overlaps are rejected at write time.
model StaffSchedule {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffId   String
  staff     User     @relation("ScheduleStaff", fields: [staffId], references: [id], onDelete: Cascade)
  weekday   Weekday
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([branchId, weekday])
  @@map("staff_schedules")
}

model Setting {
  id       String  @id @default(cuid())
  branchId String
  branch   Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  key      String
  value    String?

  @@unique([branchId, key])
  @@map("settings")
}

// Day-level presence record (ADR 028). One row per (staffId, date); `checkIn`/
// `checkOut` are absolute instants, worked time is derived (4.4 payroll will sum
// it). Corrections are edits, never deletes. `date` is a Postgres DATE so a staff
// member has exactly one record per day.
model AttendanceLog {
  id          String    @id @default(cuid())
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffId     String
  staff       User      @relation("AttendanceStaff", fields: [staffId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  notes       String?
  createdById String?
  createdBy   User?     @relation("AttendanceCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([staffId, date])
  @@index([branchId, date])
  @@map("attendance_logs")
}

// Intern profile (ADR 029) — one row per INTERN user. `school` + `rotation` +
// `mentorId` describe the placement; `requiredHours` is the contractual target and
// `completedMinutes` is derived from attendance on read (4.4 payroll will sum the
// same source). `startDate`/`endDate` bound the counting window for derived hours.
// Corrections are edits, never deletes — deactivate via `active`.
model InternProfile {
  id            String         @id @default(cuid())
  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  internId      String         @unique
  intern        User           @relation("InternProfile", fields: [internId], references: [id], onDelete: Cascade)
  school        String
  requiredHours Int
  rotation      InternRotation
  mentorId      String?
  mentor        User?          @relation("InternMentor", fields: [mentorId], references: [id])
  startDate     DateTime       @db.Date
  endDate       DateTime?      @db.Date
  notes         String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([branchId])
  @@map("intern_profiles")
}

// A `Payslip` records one payroll line per staff member per period (whole DZD,
// matching ADR 017 — no cents anywhere). `workedMinutes` and `netDZD` are
// derived on read (attendance sum in-window; net = base + bonus - deductions).
// Soft-void via `voidedAt` — payroll is never hard-deleted.
model Payslip {
  id          String    @id @default(cuid())
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffId     String
  staff       User      @relation("PayslipStaff", fields: [staffId], references: [id], onDelete: Cascade)
  periodStart DateTime  @db.Date
  periodEnd   DateTime  @db.Date
  baseDZD     Int
  bonusDZD    Int       @default(0)
  deductionsDZD Int     @default(0)
  notes       String?
  voidedAt    DateTime?
  createdById String?
  createdBy   User?     @relation("PayslipCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([branchId, staffId, periodStart, periodEnd])
  @@index([branchId, periodStart, periodEnd])
  @@index([branchId, staffId])
  @@map("payslips")
}

model AuditLog {
  id         String      @id @default(cuid())
  branchId   String
  actorId    String?
  actorEmail String?
  action     AuditAction
  targetType AuditTarget
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([branchId, createdAt])
  @@index([branchId, action, createdAt])
  @@index([action])
  @@index([actorId])
  @@map("audit_logs")
}
