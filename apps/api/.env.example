# Copy to .env and fill in real values (see infra/.env for the running stack's
# production values; keep this file in sync with it).
DATABASE_URL="postgresql://dentora:change-me-strong@127.0.0.1:5432/dentora?schema=public"
SHADOW_DATABASE_URL="postgresql://dentora:change-me-strong@127.0.0.1:5432/dentora_shadow?schema=public"
# 64 hex chars (32 bytes) AES-256 key. MUST match the key used to encrypt any
# data you intend to read (live data uses ENCRYPTION_KEY from infra/.env).
ENCRYPTION_KEY="REPLACE_WITH_64_HEX"